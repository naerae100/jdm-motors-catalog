# Sales agent — server-side only. Deliberately NOT prefixed with VITE_, which
# would inline the key into the browser bundle.
#
# Copy this file to .env and put your REAL key there. Never in this file —
# .env is gitignored, .env.example is committed.
#   cp .env.example .env
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o. Set this if your account has a different model.
# OPENAI_MODEL=gpt-4o
